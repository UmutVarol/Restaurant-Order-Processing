-- Loyalty: a business's own stamp card or points, kept by the guest's phone number (with their consent). A visit
-- counts once, when its bill is paid; a reward is taken off a bill as a discount, once.
CREATE TABLE loyalty_settings
(
    id             BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    business_id    BIGINT                   NOT NULL REFERENCES businesses (id),
    enabled        BOOLEAN                  NOT NULL DEFAULT FALSE,
    mode           VARCHAR(10)              NOT NULL DEFAULT 'STAMPS',
    stamps_needed  INT                      NOT NULL DEFAULT 8,
    reward_amount  NUMERIC(12, 2)           NOT NULL DEFAULT 100,
    points_percent NUMERIC(5, 2)            NOT NULL DEFAULT 5,
    min_spend      NUMERIC(12, 2)           NOT NULL DEFAULT 0,
    updated_at     TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by     VARCHAR(50)              NOT NULL,
    CONSTRAINT uq_loyalty_settings UNIQUE (business_id),
    CONSTRAINT ck_loyalty_settings_mode CHECK (mode IN ('STAMPS', 'POINTS')),
    CONSTRAINT ck_loyalty_settings_values CHECK (stamps_needed BETWEEN 2 AND 50 AND reward_amount > 0
        AND points_percent > 0 AND points_percent <= 50 AND min_spend >= 0)
);

CREATE TABLE loyalty_members
(
    id            BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    business_id   BIGINT                   NOT NULL REFERENCES businesses (id),
    -- in international form, +905321234567
    phone         VARCHAR(16)              NOT NULL,
    name          VARCHAR(60),
    consent_at    TIMESTAMP WITH TIME ZONE NOT NULL,
    stamps        INT                      NOT NULL DEFAULT 0,
    points        NUMERIC(12, 2)           NOT NULL DEFAULT 0,
    visits        INT                      NOT NULL DEFAULT 0,
    rewards       INT                      NOT NULL DEFAULT 0,
    last_visit_at TIMESTAMP WITH TIME ZONE,
    created_at    TIMESTAMP WITH TIME ZONE NOT NULL,
    lock_version  BIGINT                   NOT NULL DEFAULT 0,
    CONSTRAINT uq_loyalty_members_phone UNIQUE (business_id, phone),
    CONSTRAINT ck_loyalty_members_counts CHECK (stamps >= 0 AND points >= 0)
);

-- which card a bill counts for, said before or after paying
CREATE TABLE loyalty_claims
(
    id          BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    business_id BIGINT                   NOT NULL REFERENCES businesses (id),
    bill_id     BIGINT                   NOT NULL REFERENCES bills (id),
    member_id   BIGINT                   NOT NULL REFERENCES loyalty_members (id),
    claimed_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    CONSTRAINT uq_loyalty_claims_bill UNIQUE (bill_id)
);

CREATE TABLE loyalty_events
(
    id          BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    business_id BIGINT                   NOT NULL REFERENCES businesses (id),
    member_id   BIGINT                   NOT NULL REFERENCES loyalty_members (id),
    bill_id     BIGINT                   NOT NULL REFERENCES bills (id),
    kind        VARCHAR(10)              NOT NULL,
    stamps      INT                      NOT NULL DEFAULT 0,
    points      NUMERIC(12, 2)           NOT NULL DEFAULT 0,
    amount      NUMERIC(12, 2)           NOT NULL DEFAULT 0,
    created_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by  VARCHAR(50)              NOT NULL,
    -- a bill earns once and redeems once
    CONSTRAINT uq_loyalty_events_bill UNIQUE (bill_id, kind),
    CONSTRAINT ck_loyalty_events_kind CHECK (kind IN ('EARN', 'REDEEM'))
);
CREATE INDEX ix_loyalty_events_member ON loyalty_events (member_id, created_at);
