+    /**
+     * A reward the business promised (the loyalty card's), taken off an order as an amount. It needs no manager: the
+     * rule was set by one. An order that already has a discount keeps it and gets no reward on top.
+     *
+     * @throws BusinessRuleException {@code DISCOUNT_ALREADY_SET} when the order already has a manual discount
+     */
+    public OrderResponse rewardDiscount(Long orderId, java.math.BigDecimal amount, String reason, String actor) {
+        Order order = find(orderId);
+        if (order.manualDiscount() != null) {
+            throw new BusinessRuleException("DISCOUNT_ALREADY_SET", "This order already has a discount; remove it first");
+        }
+        Instant now = clock.instant();
+        OrderAdjustment adjustment = order.setManualDiscount(new ManualDiscount(null, amount), reason, now, actor, "loyalty");
+        return finish(order, adjustment, now);
+    }
+
